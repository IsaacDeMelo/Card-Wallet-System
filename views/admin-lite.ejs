<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Lite - Card Wallet</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #06110b;
      --panel: rgba(10, 20, 14, 0.82);
      --panel-2: rgba(15, 26, 18, 0.88);
      --line: rgba(255, 255, 255, 0.08);
      --text: #f4f7f5;
      --muted: #9fb0a4;
      --accent: #4ade80;
      --accent-2: #22c55e;
      --danger: #ef4444;
      --shadow: 0 18px 60px rgba(0, 0, 0, 0.35);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Poppins', sans-serif;
    }

    body {
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(74, 222, 128, 0.13), transparent 34%),
        radial-gradient(circle at bottom right, rgba(34, 197, 94, 0.12), transparent 28%),
        linear-gradient(180deg, #040805 0%, #08110c 100%);
      overflow-x: hidden;
    }

    .shell {
      width: min(1200px, calc(100vw - 32px));
      margin: 0 auto;
      padding: 22px 0 40px;
      display: grid;
      gap: 18px;
    }

    .hero {
      background: linear-gradient(180deg, rgba(12, 20, 14, 0.92), rgba(7, 13, 9, 0.9));
      border: 1px solid var(--line);
      border-radius: 22px;
      box-shadow: var(--shadow);
      padding: 20px;
      display: grid;
      gap: 14px;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: var(--accent);
      font-size: 0.72rem;
      font-weight: 700;
    }

    h1 {
      font-family: 'Cinzel', serif;
      font-size: clamp(1.7rem, 4vw, 2.6rem);
      line-height: 1;
    }

    .subtitle {
      color: var(--muted);
      max-width: 72ch;
      line-height: 1.5;
      font-size: 0.95rem;
    }

    .hero-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      justify-content: space-between;
    }

    .pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .pill {
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--line);
      color: var(--text);
      font-size: 0.82rem;
    }

    .auth-box,
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 20px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(12px);
    }

    .auth-box {
      padding: 18px;
    }

    .auth-row {
      display: grid;
      gap: 12px;
      grid-template-columns: 1fr auto;
    }

    .field {
      width: 100%;
      padding: 14px 16px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(0, 0, 0, 0.22);
      color: var(--text);
      outline: none;
      font-size: 0.98rem;
    }

    .field:focus {
      border-color: rgba(74, 222, 128, 0.55);
      box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.08);
    }

    .btn {
      border: none;
      border-radius: 14px;
      padding: 14px 16px;
      cursor: pointer;
      font-weight: 700;
      transition: transform 0.18s ease, opacity 0.18s ease, background 0.18s ease;
    }

    .btn:hover { transform: translateY(-1px); }
    .btn:active { transform: translateY(0); }

    .btn.primary {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #041008;
    }

    .btn.secondary {
      background: rgba(255, 255, 255, 0.05);
      color: var(--text);
      border: 1px solid var(--line);
    }

    .status {
      color: var(--muted);
      font-size: 0.92rem;
      min-height: 1.2em;
    }

    .status.ok { color: var(--accent); }
    .status.error { color: #fca5a5; }
    .status.warn { color: #fcd34d; }

    .top-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .stat {
      padding: 16px;
      border-radius: 18px;
      background: var(--panel-2);
      border: 1px solid var(--line);
    }

    .stat p {
      color: var(--muted);
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 6px;
    }

    .stat h3 {
      font-size: 1.4rem;
      line-height: 1;
    }

    .workspace {
      display: grid;
      grid-template-columns: 0.78fr 1.22fr;
      gap: 18px;
      align-items: start;
    }

    .panel {
      padding: 18px;
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    .panel-head h2 {
      font-size: 1.08rem;
      font-weight: 800;
    }

    .search {
      width: 100%;
      margin-bottom: 14px;
    }

    .list {
      display: grid;
      gap: 12px;
    }

    .card-item {
      padding: 14px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .card-item h3 {
      font-size: 0.98rem;
      line-height: 1.3;
      word-break: break-word;
    }

    .card-actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
      flex-wrap: wrap;
    }

    .card-actions .btn {
      padding: 10px 12px;
      border-radius: 12px;
      font-size: 0.82rem;
    }

    .btn.danger {
      background: rgba(239, 68, 68, 0.14);
      color: #fecaca;
      border: 1px solid rgba(239, 68, 68, 0.25);
    }

    .muted {
      color: var(--muted);
      font-size: 0.86rem;
    }

    .user-head {
      display: grid;
      gap: 6px;
      margin-bottom: 12px;
    }

    .user-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(74, 222, 128, 0.08);
      border: 1px solid rgba(74, 222, 128, 0.14);
      color: #b7f7cb;
      font-size: 0.76rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 10px;
    }

    .user-cards {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .user-card {
      padding: 8px 10px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(0, 0, 0, 0.2);
      font-size: 0.84rem;
      color: var(--text);
      word-break: break-word;
    }

    .empty {
      padding: 18px;
      border-radius: 16px;
      border: 1px dashed rgba(255, 255, 255, 0.14);
      color: var(--muted);
      background: rgba(255, 255, 255, 0.02);
    }

    .hidden { display: none !important; }

    @media (max-width: 900px) {
      .workspace {
        grid-template-columns: 1fr;
      }

      .stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      .shell {
        width: min(100vw - 20px, 1200px);
        padding-top: 12px;
      }

      .hero,
      .auth-box,
      .panel {
        border-radius: 18px;
      }

      .auth-row {
        grid-template-columns: 1fr;
      }

      .top-actions {
        width: 100%;
      }

      .top-actions .btn {
        flex: 1 1 0;
      }

      .stats {
        grid-template-columns: 1fr 1fr;
      }

      .user-top {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <main class="shell">
    <section class="hero">
      <div class="eyebrow">Admin Lite</div>
      <div>
        <h1>Biblioteca e usuários</h1>
        <p class="subtitle">Painel somente leitura para consultar todas as cartas cadastradas e ver cada usuário com WhatsApp, clã e a lista de cartas que ele possui, mostrando apenas o nome das cartas.</p>
      </div>
      <div class="hero-row">
        <div class="pill-row">
          <span class="pill">Consulta rápida</span>
          <span class="pill">Usuários detalhados</span>
          <span class="pill">Cartas por nome</span>
        </div>
        <div class="top-actions">
          <button class="btn secondary" id="refreshBtn" type="button">Atualizar</button>
          <button class="btn secondary" id="goWalletBtn" type="button">Wallet</button>
          <button class="btn secondary" id="logoutBtn" type="button">Sair</button>
        </div>
      </div>
    </section>

    <section class="auth-box" id="authBox">
      <div class="auth-row">
        <input class="field" id="passwordInput" type="password" placeholder="Senha admin-lite" autocomplete="current-password" />
        <button class="btn primary" id="unlockBtn" type="button">Entrar</button>
      </div>
      <p class="status" id="statusText"></p>
    </section>

    <section id="content" class="hidden">
      <div class="stats" style="margin-bottom: 18px;">
        <article class="stat">
          <p>Cartas</p>
          <h3 id="cardsCount">0</h3>
        </article>
        <article class="stat">
          <p>Usuários</p>
          <h3 id="usersCount">0</h3>
        </article>
        <article class="stat">
          <p>Usuários com cartas</p>
          <h3 id="ownersCount">0</h3>
        </article>
        <article class="stat">
          <p>Cartas atribuídas</p>
          <h3 id="ownedCardsCount">0</h3>
        </article>
      </div>

      <div class="workspace">
        <section class="panel">
          <div class="panel-head">
            <h2>Biblioteca de cartas</h2>
            <span class="badge" id="cardsVisible">0 visíveis</span>
          </div>
          <input class="field search" id="cardSearch" placeholder="Buscar carta pelo nome" />
          <div class="list" id="cardsList"></div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <h2>Usuários</h2>
            <span class="badge" id="usersVisible">0 visíveis</span>
          </div>
          <input class="field search" id="userSearch" placeholder="Buscar usuário, WhatsApp, clã ou carta" />
          <div class="list" id="usersList"></div>
        </section>
      </div>
    </section>
  </main>

  <script>
    const ADMIN_LITE_PASSWORD = 'adminrpg090920201010';

    const authBox = document.getElementById('authBox');
    const content = document.getElementById('content');
    const statusText = document.getElementById('statusText');
    const passwordInput = document.getElementById('passwordInput');
    const unlockBtn = document.getElementById('unlockBtn');
    const refreshBtn = document.getElementById('refreshBtn');
    const goWalletBtn = document.getElementById('goWalletBtn');
    const logoutBtn = document.getElementById('logoutBtn');
    const cardSearch = document.getElementById('cardSearch');
    const userSearch = document.getElementById('userSearch');
    const cardsList = document.getElementById('cardsList');
    const usersList = document.getElementById('usersList');
    const cardsCount = document.getElementById('cardsCount');
    const usersCount = document.getElementById('usersCount');
    const ownersCount = document.getElementById('ownersCount');
    const ownedCardsCount = document.getElementById('ownedCardsCount');
    const cardsVisible = document.getElementById('cardsVisible');
    const usersVisible = document.getElementById('usersVisible');

    let adminPassword = '';
    let overviewData = { cards: [], users: [] };

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function setStatus(message, type) {
      statusText.textContent = message;
      statusText.className = 'status';
      if (type) {
        statusText.classList.add(type);
      }
    }

    function getHeaders() {
      return {
        'Content-Type': 'application/json',
        'x-admin-password': adminPassword,
      };
    }

    async function fetchOverview() {
      const response = await fetch('/api/admin-lite/overview', {
        headers: getHeaders(),
      });

      const data = await response.json();
      if (!response.ok || !data.success) {
        throw new Error(data.message || 'Falha ao carregar o painel.');
      }

      return data;
    }

    function countOwnedCards(users) {
      return users.reduce((total, user) => {
        const cards = Array.isArray(user.cards) ? user.cards : [];
        return total + cards.reduce((sum, entry) => sum + (Number(entry.quantity) || 0), 0);
      }, 0);
    }

    function renderCards() {
      const search = cardSearch.value.trim().toLowerCase();
      const cards = overviewData.cards.filter((card) => {
        const title = String(card.title || '').toLowerCase();
        return title.includes(search);
      });

      cardsVisible.textContent = `${cards.length} visíveis`;

      if (!cards.length) {
        cardsList.innerHTML = '<div class="empty">Nenhuma carta encontrada.</div>';
        return;
      }

      cardsList.innerHTML = cards.map((card) => `
        <article class="card-item">
          <h3>${escapeHtml(card.title)}</h3>
          <div class="card-actions">
            <button class="btn danger delete-card-btn" type="button" data-card-id="${escapeHtml(card.cardId)}">Excluir carta</button>
          </div>
        </article>
      `).join('');
    }

    async function deleteCard(cardId) {
      if (!cardId) {
        return;
      }

      const confirmed = window.confirm(`Excluir a carta ${cardId}? Isso também remove ela de todos os usuários.`);
      if (!confirmed) {
        return;
      }

      setStatus('Excluindo carta...', '');

      const response = await fetch(`/api/admin-lite/cards/${encodeURIComponent(cardId)}`, {
        method: 'DELETE',
        headers: getHeaders(),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'Falha ao excluir a carta.');
      }

      setStatus(data.message || 'Carta excluída.', 'ok');
      await loadData();
    }

    function renderUsers() {
      const search = userSearch.value.trim().toLowerCase();
      const users = overviewData.users.filter((user) => {
        const username = String(user.username || '').toLowerCase();
        const whatsapp = String(user.whatsapp || '').toLowerCase();
        const clan = String(user.clan || '').toLowerCase();
        const cardText = (Array.isArray(user.cards) ? user.cards : []).map((entry) => String(entry.title || '').toLowerCase()).join(' ');
        return [username, whatsapp, clan, cardText].join(' ').includes(search);
      });

      usersVisible.textContent = `${users.length} visíveis`;

      if (!users.length) {
        usersList.innerHTML = '<div class="empty">Nenhum usuário encontrado.</div>';
        return;
      }

      usersList.innerHTML = users.map((user) => {
        const cards = Array.isArray(user.cards) ? user.cards : [];
        return `
          <article class="card-item">
            <div class="user-head">
              <div class="user-top">
                <h3>${escapeHtml(user.username)}</h3>
                <span class="badge">${escapeHtml(String(user.clan || '-').toUpperCase())}</span>
              </div>
              <p class="muted">WhatsApp: ${escapeHtml(user.whatsapp || '-')}</p>
            </div>
            <div class="user-cards">
              ${cards.length
                ? cards.map((entry) => `<span class="user-card">${escapeHtml(entry.title)}${entry.quantity > 1 ? ` x${escapeHtml(entry.quantity)}` : ''}</span>`).join('')
                : '<span class="muted">Sem cartas atribuídas</span>'}
            </div>
          </article>
        `;
      }).join('');
    }

    function renderStats() {
      const users = Array.isArray(overviewData.users) ? overviewData.users : [];
      const cards = Array.isArray(overviewData.cards) ? overviewData.cards : [];
      const owners = users.filter((user) => Array.isArray(user.cards) && user.cards.length > 0).length;

      cardsCount.textContent = cards.length;
      usersCount.textContent = users.length;
      ownersCount.textContent = owners;
      ownedCardsCount.textContent = countOwnedCards(users);
    }

    async function loadData() {
      setStatus('Carregando dados...', '');
      const data = await fetchOverview();
      overviewData = {
        cards: Array.isArray(data.cards) ? data.cards : [],
        users: Array.isArray(data.users) ? data.users : [],
      };
      renderStats();
      renderCards();
      renderUsers();
      setStatus('Painel carregado.', 'ok');
    }

    function unlock() {
      authBox.classList.add('hidden');
      content.classList.remove('hidden');
      content.style.display = '';
    }

    async function tryUnlock() {
      const password = passwordInput.value.trim();
      if (!password) {
        setStatus('Informe a senha do admin-lite.', 'warn');
        return;
      }

      adminPassword = password;

      try {
        await loadData();
        unlock();
        sessionStorage.setItem('adminLitePassword', adminPassword);
      } catch (error) {
        adminPassword = '';
        setStatus(error.message, 'error');
      }
    }

    unlockBtn.addEventListener('click', () => {
      tryUnlock();
    });

    refreshBtn.addEventListener('click', () => {
      loadData().catch((error) => setStatus(error.message, 'error'));
    });

    goWalletBtn.addEventListener('click', () => {
      window.location.href = '/wallet';
    });

    logoutBtn.addEventListener('click', () => {
      sessionStorage.removeItem('adminLitePassword');
      window.location.reload();
    });

    cardSearch.addEventListener('input', renderCards);
    userSearch.addEventListener('input', renderUsers);

    cardsList.addEventListener('click', (event) => {
      const button = event.target.closest('.delete-card-btn');
      if (!button) {
        return;
      }

      const cardId = button.getAttribute('data-card-id');
      deleteCard(cardId).catch((error) => setStatus(error.message, 'error'));
    });

    window.addEventListener('load', () => {
      const saved = sessionStorage.getItem('adminLitePassword') || '';
      if (saved) {
        adminPassword = saved;
        loadData()
          .then(() => {
            unlock();
            setStatus('Sessão restaurada.', 'ok');
          })
          .catch(() => {
            sessionStorage.removeItem('adminLitePassword');
            setStatus('Sessão expirada. Entre novamente.', 'warn');
          });
      } else {
        setStatus('Painel bloqueado. Informe a senha para entrar.', 'warn');
      }
    });
  </script>
</body>
</html>
