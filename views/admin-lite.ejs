<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin - Card Wallet</title>
  <link rel="icon" href="https://img.magnific.com/vetores-gratis/moldura-oriental-vermelha-vetor-de-ilustracao-de-nuvem-chinesa_53876-140200.jpg?semt=ais_hybrid&w=740&q=80" type="image/jpeg" />
  <link rel="apple-touch-icon" href="https://img.magnific.com/vetores-gratis/moldura-oriental-vermelha-vetor-de-ilustracao-de-nuvem-chinesa_53876-140200.jpg?semt=ais_hybrid&w=740&q=80" />
  <meta name="theme-color" content="#0a0e14" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-dark: #0a0e14;
      --bg-darker: #050709;
      --panel: rgba(15, 20, 30, 0.95);
      --line: rgba(76, 222, 128, 0.12);
      --text: #f4f7f5;
      --muted: #9fb0a4;
      --accent: #4ade80;
      --accent-glow: rgba(74, 222, 128, 0.3);
      --danger: #ef4444;
      --shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', sans-serif; }
    html, body { width: 100%; }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-dark); }
    ::-webkit-scrollbar-thumb { background: #2a3f2f; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

    body {
      min-height: 100vh;
      color: var(--text);
      background: linear-gradient(135deg, var(--bg-dark) 0%, var(--bg-darker) 100%);
      overflow-x: hidden;
    }

    .layout {
      display: grid;
      grid-template-columns: 260px 1fr;
      min-height: 100vh;
      gap: 0;
    }

    /* SIDEBAR */
    .sidebar {
      grid-column: 1;
      background: var(--panel);
      border-right: 1px solid var(--line);
      padding: 28px 18px;
      display: flex;
      flex-direction: column;
      gap: 28px;
      position: fixed;
      width: 260px;
      height: 100vh;
      overflow-y: auto;
      z-index: 100;
    }

    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      border-radius: 12px;
      background: rgba(76, 222, 128, 0.1);
      border: 1px solid var(--accent);
    }

    .sidebar-logo h2 {
      font-size: 1.1rem;
      color: var(--accent);
      font-family: 'Cinzel', serif;
      margin: 0;
    }

    .nav-section {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .nav-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--muted);
      padding: 10px 14px;
      font-weight: 800;
    }

    .nav-item {
      padding: 12px 16px;
      border: 1px solid transparent;
      border-radius: 10px;
      background: transparent;
      color: var(--text);
      cursor: pointer;
      font-weight: 600;
      transition: all 0.25s;
      text-align: left;
      font-size: 0.9rem;
    }

    .nav-item:hover {
      background: rgba(76, 222, 128, 0.08);
      border-color: rgba(76, 222, 128, 0.2);
    }

    .nav-item.active {
      background: var(--accent);
      color: #000;
      border-color: var(--accent);
      box-shadow: 0 4px 12px var(--accent-glow);
    }

    .nav-actions {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    /* MAIN CONTENT */
    .main {
      grid-column: 2;
      padding: 36px 40px;
      overflow-y: auto;
      margin-left: 0;
    }

    .page-header {
      margin-bottom: 32px;
    }

    .page-title {
      font-size: 2.2rem;
      font-family: 'Cinzel', serif;
      color: #fff;
      text-shadow: 0 0 20px var(--accent-glow);
      margin-bottom: 8px;
    }

    .page-subtitle {
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.5;
    }

    /* AUTH SCREEN */
    .auth-screen {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--bg-dark), var(--bg-darker));
      z-index: 999;
      backdrop-filter: blur(8px);
    }

    .auth-box {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 32px;
      max-width: 420px;
      width: 100%;
      margin: 20px;
      box-shadow: var(--shadow);
    }

    .auth-box h1 {
      font-size: 2rem;
      font-family: 'Cinzel', serif;
      margin-bottom: 8px;
      color: #fff;
    }

    .auth-box p {
      color: var(--muted);
      margin-bottom: 24px;
      font-size: 0.95rem;
    }

    /* SECTIONS */
    .section {
      display: none;
    }

    .section.active {
      display: block;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* PANELS */
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 24px;
      box-shadow: var(--shadow);
      margin-bottom: 24px;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      border-bottom: 2px solid var(--line);
      padding-bottom: 12px;
    }

    .panel-title {
      font-size: 1.3rem;
      font-weight: 800;
      color: #fff;
    }

    .badge {
      padding: 6px 12px;
      border-radius: 8px;
      background: rgba(76, 222, 128, 0.15);
      color: var(--accent);
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    /* GRIDS */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 32px;
    }

    .stat {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
      box-shadow: var(--shadow);
    }

    .stat-value {
      font-size: 2.5rem;
      font-weight: 900;
      color: var(--accent);
      font-family: 'Cinzel', serif;
      line-height: 1;
      margin-bottom: 8px;
    }

    .stat-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--muted);
      font-weight: 700;
    }

    .workspace {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    /* FORMS */
    .input-group {
      margin-bottom: 16px;
    }

    .input-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--muted);
      margin-bottom: 8px;
    }

    input, select, textarea {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: rgba(0, 0, 0, 0.3);
      color: var(--text);
      font-size: 0.95rem;
      outline: none;
      transition: all 0.2s;
    }

    input:focus, select:focus, textarea:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
      background: rgba(0, 0, 0, 0.5);
    }

    select option { background: var(--bg-dark); color: #fff; }

    /* BUTTONS */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      border: 1px solid transparent;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.2s;
      width: 100%;
    }

    .btn:hover { transform: translateY(-2px); }

    .btn.primary {
      background: var(--accent);
      color: #000;
      box-shadow: 0 4px 12px var(--accent-glow);
    }

    .btn.primary:hover { box-shadow: 0 6px 16px var(--accent-glow); }

    .btn.secondary {
      background: rgba(76, 222, 128, 0.1);
      color: var(--accent);
      border: 1px solid var(--accent);
    }

    .btn.secondary:hover { background: rgba(76, 222, 128, 0.2); }

    .btn.danger {
      background: rgba(239, 68, 68, 0.12);
      color: #ff7070;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn.danger:hover { background: rgba(239, 68, 68, 0.25); }

    .btn-small { padding: 8px 14px; font-size: 0.8rem; width: auto; }

    .btn-group {
      display: flex;
      gap: 10px;
    }

    /* LISTS */
    .list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-height: 500px;
      overflow-y: auto;
    }

    .list-item {
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(76, 222, 128, 0.08);
      border-radius: 10px;
      padding: 14px;
      transition: all 0.2s;
      cursor: pointer;
    }

    .list-item:hover {
      border-color: var(--accent);
      background: rgba(76, 222, 128, 0.05);
    }

    .list-item-title {
      font-weight: 700;
      color: #fff;
      margin-bottom: 4px;
    }

    .list-item-meta {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .list-item-badge {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 6px;
      background: rgba(76, 222, 128, 0.15);
      color: var(--accent);
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      margin-top: 8px;
    }

    /* MODAL */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 20px;
      backdrop-filter: blur(4px);
    }

    .modal.active { display: flex; }

    .modal-content {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 28px;
      max-width: 500px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      box-shadow: var(--shadow);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 20px;
      border-bottom: 2px solid var(--line);
      padding-bottom: 14px;
      gap: 16px;
    }

    .modal-title {
      font-size: 1.5rem;
      font-weight: 800;
      color: #fff;
      font-family: 'Cinzel', serif;
    }

    .modal-close {
      background: none;
      border: none;
      color: var(--muted);
      font-size: 24px;
      cursor: pointer;
      padding: 0;
      line-height: 1;
    }

    .modal-close:hover { color: #fff; }

    .modal-section {
      background: rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(76, 222, 128, 0.08);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 14px;
    }

    .modal-section h4 {
      color: var(--accent);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 12px;
      font-weight: 800;
    }

    .inventory-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0, 0, 0, 0.3);
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid rgba(76, 222, 128, 0.05);
      margin-bottom: 8px;
    }

    /* RECRUITMENT */
    .recruitment-item {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px;
      background: linear-gradient(135deg, rgba(76, 222, 128, 0.05) 0%, rgba(76, 222, 128, 0.02) 100%);
      border: 1px solid rgba(76, 222, 128, 0.15);
      border-radius: 12px;
      transition: all 0.3s ease;
    }

    .recruitment-item:hover {
      background: linear-gradient(135deg, rgba(76, 222, 128, 0.1) 0%, rgba(76, 222, 128, 0.05) 100%);
      border-color: rgba(76, 222, 128, 0.25);
      box-shadow: 0 4px 12px rgba(76, 222, 128, 0.1);
    }

    .recruitment-rank {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      min-width: 50px;
    }

    .rank-medal {
      font-size: 1.8rem;
    }

    .rank-position {
      font-size: 0.7rem;
      color: var(--muted);
      font-weight: 700;
    }

    .recruitment-info {
      flex: 1;
    }

    .recruitment-name {
      font-weight: 700;
      color: var(--text);
      font-size: 0.95rem;
      margin-bottom: 3px;
    }

    .recruitment-meta {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .recruitment-badge {
      background: linear-gradient(135deg, var(--accent) 0%, #3dd66f 100%);
      color: var(--bg-dark);
      font-weight: 800;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 0.85rem;
      min-width: 40px;
      text-align: center;
    }

    /* STATUS */
    .status {
      padding: 12px 16px;
      border-radius: 10px;
      margin-top: 12px;
      font-weight: 600;
      display: none;
      font-size: 0.9rem;
    }

    .status.show { display: block; }
    .status.success { background: rgba(76, 222, 128, 0.15); color: var(--accent); }
    .status.error { background: rgba(239, 68, 68, 0.15); color: #ff7070; }

    .empty {
      padding: 40px 20px;
      text-align: center;
      color: var(--muted);
      border-radius: 10px;
      border: 2px dashed rgba(76, 222, 128, 0.1);
    }

    /* MOBILE NAVBAR */
    .mobile-header {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: var(--panel);
      border-bottom: 1px solid var(--line);
      z-index: 200;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
    }

    .mobile-header-title {
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--accent);
      font-family: 'Cinzel', serif;
    }

    .hamburger {
      background: none;
      border: none;
      color: var(--text);
      font-size: 24px;
      cursor: pointer;
      padding: 8px;
    }

    /* DRAWER OVERLAY */
    .drawer-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 99;
    }

    .drawer-overlay.active { display: block; }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
      .layout { grid-template-columns: 220px 1fr; }
      .sidebar { width: 220px; }
      .main { padding: 28px 32px; }
      .stats-grid { grid-template-columns: 1fr 1fr; }
      .workspace { grid-template-columns: 1fr; }
    }

    @media (max-width: 768px) {
      .mobile-header { display: flex; }
      
      .layout {
        grid-template-columns: 1fr;
        padding-top: 60px;
      }

      .sidebar {
        position: fixed;
        left: 0;
        top: 60px;
        width: 280px;
        height: calc(100vh - 60px);
        z-index: 150;
        background: var(--panel);
        border-right: 1px solid var(--line);
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        overflow-y: auto;
        grid-column: auto;
      }

      .sidebar.active { transform: translateX(0); }

      .main {
        grid-column: 1;
        padding: 20px 14px;
        padding-top: 16px;
      }

      .page-title { font-size: 1.6rem; }
      .page-subtitle { font-size: 0.85rem; }

      .stats-grid { grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
      .stat { padding: 14px; }
      .stat-value { font-size: 2rem; }
      .stat-label { font-size: 0.7rem; }

      .workspace { grid-template-columns: 1fr; gap: 16px; }
      .panel { padding: 16px; margin-bottom: 16px; border-radius: 12px; }
      .panel-header { margin-bottom: 14px; padding-bottom: 10px; }
      .panel-title { font-size: 1.1rem; }

      .form-grid { gap: 10px; }
      .input-group { margin-bottom: 12px; }
      .input-label { font-size: 0.75rem; margin-bottom: 6px; }

      input, select, textarea {
        padding: 11px 12px;
        font-size: 16px;
        border-radius: 8px;
      }

      .btn {
        width: 100%;
        padding: 14px 16px;
        font-size: 0.95rem;
        border-radius: 8px;
      }

      .btn-group {
        flex-direction: column;
        gap: 8px;
      }

      .btn-small { width: 100%; padding: 12px; }

      .list { max-height: 350px; gap: 10px; }
      .list-item { padding: 12px; border-radius: 8px; }
      .list-item-title { font-size: 0.95rem; margin-bottom: 3px; }
      .list-item-meta { font-size: 0.75rem; }

      .modal-content {
        padding: 20px;
        border-radius: 12px;
        max-width: 100%;
        margin: 16px;
      }

      .modal-title { font-size: 1.3rem; }
      .inventory-item { padding: 10px; gap: 8px; }

      .recruitment-item { padding: 12px; gap: 12px; }
      .rank-medal { font-size: 1.4rem; }
      .recruitment-name { font-size: 0.9rem; }
      .recruitment-badge { padding: 5px 10px; font-size: 0.75rem; }

      .page-header { margin-bottom: 16px; }
    }

    @media (max-width: 480px) {
      .stats-grid { grid-template-columns: 1fr; }
      .stat-value { font-size: 1.8rem; }
      .page-title { font-size: 1.4rem; }
      .form-grid { gap: 8px; }
      .workspace { gap: 12px; }
      .modal-content { margin: 10px; padding: 16px; }
      .btn-group { flex-direction: column; }
      .nav-section { gap: 6px; }
      .nav-item { padding: 10px 14px; font-size: 0.85rem; }
    }
  </style>
</head>
<body>
  <!-- AUTH SCREEN -->
  <div id="authScreen" class="auth-screen">
    <div class="auth-box">
      <h1>🔐 Admin</h1>
      <p>Digite a senha para acessar o painel</p>
      <div class="input-group">
        <input id="passwordInput" type="password" placeholder="Senha admin-lite..." />
      </div>
      <button class="btn primary" onclick="authenticate()">Desbloquear</button>
      <div id="authStatus" class="status"></div>
    </div>
  </div>

  <!-- MOBILE HEADER (NAVBAR) -->
  <div id="mobileHeader" class="mobile-header">
    <button class="hamburger" onclick="toggleDrawer()">☰</button>
    <div class="mobile-header-title" id="mobileTitle">Dashboard</div>
    <button class="hamburger" onclick="showMenuActions()">⋮</button>
  </div>

  <!-- DRAWER OVERLAY -->
  <div id="drawerOverlay" class="drawer-overlay" onclick="closeDrawer()"></div>

  <!-- MAIN LAYOUT -->
  <div id="mainLayout" class="layout" style="display: none;">
    <!-- Sidebar / Drawer (Mobile) -->
    <aside id="sidebar" class="sidebar">
      <div class="sidebar-logo">
        <span style="font-size: 1.4rem;">🏛️</span>
        <h2>Admin</h2>
      </div>

      <div class="nav-section">
        <div class="nav-label">Menu</div>
        <button class="nav-item active" onclick="switchSection('dashboard')">📊 Dashboard</button>
        <button class="nav-item" onclick="switchSection('cards')">🃏 Cartas</button>
        <button class="nav-item" onclick="switchSection('users')">👥 Usuários</button>
        <button class="nav-item" onclick="switchSection('recruitment')">🎖️ Recrutamento</button>
      </div>

      <div class="nav-actions">
        <button class="btn secondary btn-small" onclick="refreshData()" style="width: 100%;">🔄 Atualizar</button>
        <button class="btn secondary btn-small" onclick="goWallet()" style="width: 100%;">💼 Wallet</button>
        <button class="btn danger btn-small" onclick="logout()" style="width: 100%;">🚪 Sair</button>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main"></main>
  </div>

  <!-- User Modal -->
  <div id="userModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <div class="modal-title" id="modalUserName">Usuário</div>
          <p style="color: var(--muted); font-size: 0.85rem; margin-top: 4px;" id="modalUserInfo">-</p>
        </div>
        <button class="modal-close" onclick="closeUserModal()">&times;</button>
      </div>

      <div class="modal-section">
        <h4>Bolsa Ninja (Cartas Atuais)</h4>
        <div id="modalInventory" style="display: flex; flex-direction: column; gap: 8px;"></div>
      </div>

      <div class="modal-section">
        <h4>Entregar Nova Carta</h4>
        <div class="input-group" style="margin-bottom: 12px;">
          <select id="modalCardSelect"></select>
        </div>
        <div class="input-group" style="margin-bottom: 12px;">
          <input id="modalQuantity" type="number" value="1" min="1" placeholder="Quantidade" />
        </div>
        <button class="btn primary" onclick="addCardFromModal()" style="margin-bottom: 8px;">Entregar Carta</button>
        <button class="btn danger" onclick="deleteUser()">Excluir Usuário Permanentemente</button>
        <div id="modalStatus" class="status" style="font-size: 0.85rem;"></div>
      </div>
    </div>
  </div>

  <script>
    // VARIABLES
    let adminPassword = '';
    let allCards = [];
    let allUsers = [];
    let currentModalUser = null;

    // DRAWER FUNCTIONS (Mobile)
    function toggleDrawer() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('drawerOverlay');
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
    }

    function closeDrawer() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('drawerOverlay');
      sidebar.classList.remove('active');
      overlay.classList.remove('active');
    }

    function showMenuActions() {
      // On mobile, show options for refresh/wallet/logout
      const choice = prompt('Opções:\n1. Atualizar\n2. Wallet\n3. Sair\n\nDigite o número:');
      if (choice === '1') refreshData();
      else if (choice === '2') goWallet();
      else if (choice === '3') logout();
    }

    // FUNCTIONS
    function showStatus(elementId, msg, type) {
      const el = document.getElementById(elementId);
      el.textContent = msg;
      el.className = `status show ${type}`;
      setTimeout(() => el.classList.remove('show'), 3500);
    }

    async function authenticate() {
      adminPassword = document.getElementById('passwordInput').value.trim();
      if (!adminPassword) {
        showStatus('authStatus', '❌ Informe a senha', 'error');
        return;
      }

      try {
        const res = await fetch('/api/admin-lite/overview', {
          headers: { 'x-admin-password': adminPassword }
        });
        const data = await res.json();

        if (!data.success) {
          showStatus('authStatus', '❌ Senha incorreta', 'error');
          adminPassword = '';
          return;
        }

        document.getElementById('authScreen').style.display = 'none';
        document.getElementById('mainLayout').style.display = 'grid';
        document.getElementById('mobileHeader').style.display = 'flex';
        refreshData();
      } catch (e) {
        showStatus('authStatus', '❌ Erro: ' + e.message, 'error');
      }
    }

    function switchSection(section) {
      document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
      document.getElementById(section).classList.add('active');
      event.target.classList.add('active');
      
      // Update mobile header title
      const titles = {
        'dashboard': '📊 Dashboard',
        'cards': '🃏 Cartas',
        'users': '👥 Usuários'
      };
      document.getElementById('mobileTitle').textContent = titles[section] || 'Admin';
      
      // Close drawer on mobile
      closeDrawer();
    }

    async function refreshData() {
      try {
        const res = await fetch('/api/admin-lite/overview', {
          headers: { 'x-admin-password': adminPassword }
        });
        const data = await res.json();

        allCards = data.cards || [];
        allUsers = data.users || [];

        updateStats();
        renderAllSections();
        populateSelects();
      } catch (e) {
        console.error('Erro ao carregar dados:', e);
      }
    }

    function renderAllSections() {
      renderDashboard();
      renderCardsSection();
      renderUsersSection();
      renderRecruitmentSection();
    }

    function renderDashboard() {
      let totalInv = 0, collectors = 0;
      allUsers.forEach(u => {
        const cards = u.cards || [];
        if (cards.length) collectors++;
        cards.forEach(c => totalInv += c.quantity || 0);
      });

      const html = `
        <div class="page-header">
          <h1 class="page-title">Dashboard</h1>
          <p class="page-subtitle">Visão geral e gerenciamento rápido</p>
        </div>

        <div class="stats-grid">
          <div class="stat">
            <div class="stat-value" id="cardsTotal">${allCards.length}</div>
            <div class="stat-label">Cartas</div>
          </div>
          <div class="stat">
            <div class="stat-value" id="usersTotal">${allUsers.length}</div>
            <div class="stat-label">Usuários</div>
          </div>
          <div class="stat">
            <div class="stat-value" id="collectorsTotal">${collectors}</div>
            <div class="stat-label">Colecionadores</div>
          </div>
          <div class="stat">
            <div class="stat-value" id="inventoryTotal">${totalInv}</div>
            <div class="stat-label">Em Posse</div>
          </div>
        </div>

        <div class="workspace">
          <!-- Create Card Panel -->
          <div class="panel">
            <div class="panel-header">
              <h2 class="panel-title">Criar Carta</h2>
              <span class="badge">Rápido</span>
            </div>
            <div class="form-grid">
              <div class="input-group">
                <label class="input-label">ID da Carta</label>
                <input id="createCardId" type="text" placeholder="ex: fire001" />
              </div>
              <div class="input-group">
                <label class="input-label">Nome</label>
                <input id="createCardName" type="text" placeholder="ex: Bola de Fogo" />
              </div>
              <div class="input-group">
                <label class="input-label">Tipo/Raridade</label>
                <input id="createCardType" type="text" placeholder="ex: Fogo" />
              </div>
              <button class="btn primary" onclick="createCard()">Forjar Carta</button>
              <div id="createStatus" class="status"></div>
            </div>
          </div>

          <!-- Manage Inventory Panel -->
          <div class="panel">
            <div class="panel-header">
              <h2 class="panel-title">Inventário</h2>
              <span class="badge">Entregar/Remover</span>
            </div>
            <div class="form-grid">
              <div class="input-group">
                <label class="input-label">Usuário</label>
                <select id="userSelect" onchange="updateCardSelect()"></select>
              </div>
              <div class="input-group">
                <label class="input-label">Carta</label>
                <select id="cardSelect"></select>
              </div>
              <div class="input-group">
                <label class="input-label">Quantidade</label>
                <input id="quantityInput" type="number" value="1" min="1" />
              </div>
              <div class="btn-group">
                <button class="btn primary" onclick="assignCard()">➕ Entregar</button>
                <button class="btn danger" onclick="removeCard()">➖ Remover</button>
              </div>
              <div id="inventoryStatus" class="status"></div>
            </div>
          </div>
        </div>
      `;

      const dashboard = document.getElementById('dashboard');
      if (dashboard) {
        dashboard.innerHTML = html;
      } else {
        const main = document.querySelector('.main');
        const section = document.createElement('section');
        section.id = 'dashboard';
        section.className = 'section active';
        section.innerHTML = html;
        main.appendChild(section);
      }
    }

    function renderCardsSection() {
      const html = `
        <div class="page-header">
          <h1 class="page-title">Cartas</h1>
          <p class="page-subtitle">Acervo completo de cartas do sistema</p>
        </div>

        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">Pesquisar</h2>
            <span class="badge" id="cardsCount">${allCards.length}</span>
          </div>
          <input id="cardSearch" type="text" placeholder="Pesquisar por nome ou ID..." oninput="filterCards()" />
          <div class="list" id="cardsList" style="margin-top: 16px;">
            ${allCards.length === 0 ? '<div class="empty">Nenhuma carta</div>' : allCards.map(c => `
              <div class="list-item" onclick="deleteCardConfirm('${c.cardId}')">
                <div class="list-item-title">${c.title || c.cardId}</div>
                <div class="list-item-meta">#${c.cardId} • ${c.categoria || 'N/A'}</div>
                <span class="list-item-badge">Toque para deletar</span>
              </div>
            `).join('')}
          </div>
        </div>
      `;

      const cards = document.getElementById('cards');
      if (cards) {
        cards.innerHTML = html;
      } else {
        const main = document.querySelector('.main');
        const section = document.createElement('section');
        section.id = 'cards';
        section.className = 'section';
        section.innerHTML = html;
        main.appendChild(section);
      }
    }

    function renderUsersSection() {
      const html = `
        <div class="page-header">
          <h1 class="page-title">Usuários</h1>
          <p class="page-subtitle">Gerenciar shinobis e seus inventários</p>
        </div>

        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">Pesquisar</h2>
            <span class="badge" id="usersCount">${allUsers.length}</span>
          </div>
          <input id="userSearch" type="text" placeholder="Pesquisar por nome ou clã..." oninput="filterUsers()" />
          <div class="list" id="usersList" style="margin-top: 16px;">
            ${allUsers.length === 0 ? '<div class="empty">Nenhum usuário</div>' : allUsers.map(u => {
              const cards = u.cards || [];
              const total = cards.reduce((s, c) => s + (c.quantity || 0), 0);
              return `
                <div class="list-item" onclick="openUserModal('${u.username}')">
                  <div class="list-item-title">${u.username}</div>
                  <div class="list-item-meta">🏮 ${u.clan} • ${total} cartas • 📱 ${u.whatsapp || '-'}</div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;

      const users = document.getElementById('users');
      if (users) {
        users.innerHTML = html;
      } else {
        const main = document.querySelector('.main');
        const section = document.createElement('section');
        section.id = 'users';
        section.className = 'section';
        section.innerHTML = html;
        main.appendChild(section);
      }
    }

    function renderRecruitmentSection() {
      const html = `
        <div class="page-header">
          <h1 class="page-title">Recrutamento</h1>
          <p class="page-subtitle">Ranking de recrutadores ninja</p>
        </div>

        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">🎖️ Ranking de Recrutadores</h2>
            <span class="badge" id="recruitmentCount">0</span>
          </div>
          <div class="recruitment-ranking" id="recruitmentList" style="display: flex; flex-direction: column; gap: 12px;">
            <div class="empty">Carregando ranking...</div>
          </div>
        </div>
      `;

      const recruitment = document.getElementById('recruitment');
      if (recruitment) {
        recruitment.innerHTML = html;
      } else {
        const main = document.querySelector('.main');
        const section = document.createElement('section');
        section.id = 'recruitment';
        section.className = 'section';
        section.innerHTML = html;
        main.appendChild(section);
      }

      loadRecruitmentRanking();
    }

    async function loadRecruitmentRanking() {
      try {
        const res = await fetch('/api/admin-lite/recruitment', {
          headers: { 'x-admin-password': adminPassword }
        });
        const data = await res.json();

        if (!data.success) return;

        const ranking = data.ranking || [];
        const recruitmentCount = document.getElementById('recruitmentCount');
        if (recruitmentCount) recruitmentCount.textContent = data.totalRecruited || 0;

        const recruitmentList = document.getElementById('recruitmentList');
        if (!recruitmentList) return;

        if (!ranking.length) {
          recruitmentList.innerHTML = '<div class="empty">Nenhum recrutamento registrado ainda</div>';
          return;
        }

        recruitmentList.innerHTML = ranking.map((item, index) => {
          const medal = index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : '⭐';
          return `
            <div class="recruitment-item">
              <div class="recruitment-rank">
                <span class="rank-medal">${medal}</span>
                <span class="rank-position">#${index + 1}</span>
              </div>
              <div class="recruitment-info">
                <div class="recruitment-name">${item.recruiter}</div>
                <div class="recruitment-meta">${item.recruits} ninja${item.recruits !== 1 ? 's' : ''} recrutado${item.recruits !== 1 ? 's' : ''}</div>
              </div>
              <div class="recruitment-badge">${item.recruits}</div>
            </div>
          `;
        }).join('');
      } catch (e) {
        console.error('Erro ao carregar recrutamento:', e);
      }
    }

    function updateStats() {
      let totalInv = 0, collectors = 0;
      allUsers.forEach(u => {
        const cards = u.cards || [];
        if (cards.length) collectors++;
        cards.forEach(c => totalInv += c.quantity || 0);
      });

      const cardsTotal = document.getElementById('cardsTotal');
      const usersTotal = document.getElementById('usersTotal');
      const collectorsTotal = document.getElementById('collectorsTotal');
      const inventoryTotal = document.getElementById('inventoryTotal');

      if (cardsTotal) cardsTotal.textContent = allCards.length;
      if (usersTotal) usersTotal.textContent = allUsers.length;
      if (collectorsTotal) collectorsTotal.textContent = collectors;
      if (inventoryTotal) inventoryTotal.textContent = totalInv;
    }

    function renderCards() {
      const search = (document.getElementById('cardSearch') || {}).value?.toLowerCase() || '';
      const filtered = allCards.filter(c =>
        (c.title || '').toLowerCase().includes(search) ||
        (c.cardId || '').toLowerCase().includes(search)
      );

      const cardsCount = document.getElementById('cardsCount');
      if (cardsCount) cardsCount.textContent = filtered.length;

      const cardsList = document.getElementById('cardsList');
      if (!cardsList) return;

      if (!filtered.length) {
        cardsList.innerHTML = '<div class="empty">Nenhuma carta encontrada</div>';
        return;
      }

      cardsList.innerHTML = filtered.map(c => `
        <div class="list-item" onclick="deleteCardConfirm('${c.cardId}')">
          <div class="list-item-title">${c.title || c.cardId}</div>
          <div class="list-item-meta">#${c.cardId} • ${c.categoria || 'N/A'}</div>
          <span class="list-item-badge">Toque para deletar</span>
        </div>
      `).join('');
    }

    function filterCards() { renderCards(); }

    function renderUsers() {
      const search = (document.getElementById('userSearch') || {}).value?.toLowerCase() || '';
      const filtered = allUsers.filter(u =>
        (u.username || '').toLowerCase().includes(search) ||
        (u.clan || '').toLowerCase().includes(search)
      );

      const usersCount = document.getElementById('usersCount');
      if (usersCount) usersCount.textContent = filtered.length;

      const usersList = document.getElementById('usersList');
      if (!usersList) return;

      if (!filtered.length) {
        usersList.innerHTML = '<div class="empty">Nenhum usuário encontrado</div>';
        return;
      }

      usersList.innerHTML = filtered.map(u => {
        const cards = u.cards || [];
        const total = cards.reduce((s, c) => s + (c.quantity || 0), 0);
        return `
          <div class="list-item" onclick="openUserModal('${u.username}')">
            <div class="list-item-title">${u.username}</div>
            <div class="list-item-meta">🏮 ${u.clan} • ${total} cartas • 📱 ${u.whatsapp || '-'}</div>
          </div>
        `;
      }).join('');
    }

    function filterUsers() { renderUsers(); }

    function populateSelects() {
      document.getElementById('userSelect').innerHTML = allUsers.map(u =>
        `<option value="${u.username}">${u.username}</option>`
      ).join('') || '<option value="">Nenhum usuário</option>';

      document.getElementById('cardSelect').innerHTML = allCards.map(c =>
        `<option value="${c.cardId}">${c.title || c.cardId}</option>`
      ).join('') || '<option value="">Nenhuma carta</option>';

      document.getElementById('modalCardSelect').innerHTML = allCards.map(c =>
        `<option value="${c.cardId}">${c.title || c.cardId}</option>`
      ).join('') || '<option value="">Nenhuma carta</option>';
    }

    function updateCardSelect() { /* Optional */ }

    async function createCard() {
      const id = document.getElementById('createCardId').value.trim();
      const name = document.getElementById('createCardName').value.trim();
      const type = document.getElementById('createCardType').value.trim();

      if (!id || !name || !type) {
        showStatus('createStatus', '❌ Preencha todos os campos', 'error');
        return;
      }

      try {
        const res = await fetch('/api/admin-lite/cards', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-admin-password': adminPassword },
          body: JSON.stringify({ cardId: id, title: name, categoria: type, draw: '', url: '' })
        });
        const data = await res.json();

        if (data.success) {
          showStatus('createStatus', '✅ Carta criada!', 'success');
          document.getElementById('createCardId').value = '';
          document.getElementById('createCardName').value = '';
          document.getElementById('createCardType').value = '';
          refreshData();
        } else {
          showStatus('createStatus', '❌ ' + (data.message || 'Erro'), 'error');
        }
      } catch (e) {
        showStatus('createStatus', '❌ ' + e.message, 'error');
      }
    }

    async function assignCard() {
      const username = document.getElementById('userSelect').value;
      const cardId = document.getElementById('cardSelect').value;
      const qty = parseInt(document.getElementById('quantityInput').value) || 1;

      if (!username || !cardId) {
        showStatus('inventoryStatus', '❌ Selecione usuário e carta', 'error');
        return;
      }

      try {
        const res = await fetch('/api/admin/assign', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-admin-password': adminPassword },
          body: JSON.stringify({ username, cardId, quantity: qty })
        });
        const data = await res.json();

        if (data.success) {
          showStatus('inventoryStatus', '✅ Carta entregue!', 'success');
          refreshData();
        } else {
          showStatus('inventoryStatus', '❌ ' + (data.message || 'Erro'), 'error');
        }
      } catch (e) {
        showStatus('inventoryStatus', '❌ ' + e.message, 'error');
      }
    }

    async function removeCard() {
      const username = document.getElementById('userSelect').value;
      const cardId = document.getElementById('cardSelect').value;
      const qty = parseInt(document.getElementById('quantityInput').value) || 1;

      if (!username || !cardId) {
        showStatus('inventoryStatus', '❌ Selecione usuário e carta', 'error');
        return;
      }

      try {
        const res = await fetch('/api/admin/remove', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-admin-password': adminPassword },
          body: JSON.stringify({ username, cardId, quantity: qty })
        });
        const data = await res.json();

        if (data.success) {
          showStatus('inventoryStatus', '✅ Carta removida!', 'success');
          refreshData();
        } else {
          showStatus('inventoryStatus', '❌ ' + (data.message || 'Erro'), 'error');
        }
      } catch (e) {
        showStatus('inventoryStatus', '❌ ' + e.message, 'error');
      }
    }

    async function deleteCardConfirm(cardId) {
      if (!confirm(`Deletar a carta [${cardId}] do banco? Todos os usuários perderão.`)) return;

      try {
        const res = await fetch(`/api/admin-lite/cards/${cardId}`, {
          method: 'DELETE',
          headers: { 'x-admin-password': adminPassword }
        });
        const data = await res.json();

        if (data.success) {
          refreshData();
        }
      } catch (e) {
        console.error(e);
      }
    }

    function openUserModal(username) {
      const user = allUsers.find(u => u.username === username);
      if (!user) return;

      currentModalUser = user;
      document.getElementById('modalUserName').textContent = username;
      document.getElementById('modalUserInfo').textContent = `Clã: ${user.clan} • WhatsApp: ${user.whatsapp || '-'}`;

      const inv = user.cards || [];
      if (!inv.length) {
        document.getElementById('modalInventory').innerHTML = '<div class="empty" style="padding: 20px;">Bolsa vazia</div>';
      } else {
        document.getElementById('modalInventory').innerHTML = inv.map(c => `
          <div class="inventory-item">
            <div>
              <div style="font-weight: 700; color: #fff;">${c.title || c.cardId}</div>
              <div style="color: var(--muted); font-size: 0.8rem;">ID: ${c.cardId}</div>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="color: var(--accent); font-weight: 800;">x${c.quantity}</span>
            </div>
          </div>
        `).join('');
      }

      document.getElementById('userModal').classList.add('active');
    }

    function closeUserModal() {
      document.getElementById('userModal').classList.remove('active');
      currentModalUser = null;
    }

    async function addCardFromModal() {
      if (!currentModalUser) return;
      const cardId = document.getElementById('modalCardSelect').value;
      const qty = parseInt(document.getElementById('modalQuantity').value) || 1;

      if (!cardId) return;

      try {
        const res = await fetch('/api/admin/assign', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-admin-password': adminPassword },
          body: JSON.stringify({ username: currentModalUser.username, cardId, quantity: qty })
        });
        const data = await res.json();

        if (data.success) {
          refreshData();
          openUserModal(currentModalUser.username);
        }
      } catch (e) {
        console.error(e);
      }
    }

    async function deleteUser() {
      if (!currentModalUser) return;
      if (!confirm(`DELETAR ${currentModalUser.username}? Permanente!`)) return;

      try {
        const res = await fetch(`/api/admin/users/${currentModalUser.username}`, {
          method: 'DELETE',
          headers: { 'x-admin-password': adminPassword }
        });
        const data = await res.json();

        if (data.success) {
          closeUserModal();
          refreshData();
        }
      } catch (e) {
        console.error(e);
      }
    }

    function goWallet() { window.location.href = '/wallet'; }

    function logout() {
      adminPassword = '';
      document.getElementById('authScreen').style.display = 'flex';
      document.getElementById('mainLayout').style.display = 'none';
      document.getElementById('mobileHeader').style.display = 'none';
      document.getElementById('passwordInput').value = '';
      closeDrawer();
    }

    // Init
    document.getElementById('mobileHeader').style.display = 'none';
    document.getElementById('passwordInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') authenticate();
    });
  </script>
</body>
</html>
